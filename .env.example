# Offline by default. An API key alone NEVER enables paid requests.
AI_MODE=simulation
ALLOW_PAID_API=false
# Later, enable live mode only by setting BOTH AI_MODE=live and ALLOW_PAID_API=true.
# LLM provider (OpenAI-compatible)
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=replace-with-an-available-model

# Dedicated multimodal OCR provider (OpenAI-compatible image input API).
# DeepSeek remains responsible for text reasoning and grading only.
VISION_PROVIDER=openai-compatible
VISION_API_KEY=replace-with-your-vision-provider-key
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=replace-with-a-vision-capable-model
VISION_MAX_TOKENS=4096

# Generation controls
DEFAULT_TEMPERATURE=0.5
DEFAULT_MAX_TOKENS=16384
DEFAULT_TOP_P=0.95
MAX_RETRIES=3

# Optional embedding-based deduplication. Keep false unless the model has been
# provisioned locally; otherwise the system uses deterministic text fingerprints.
ENABLE_SEMANTIC_DEDUP=false
SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Local retrieval: CUDA preferred, CPU fallback automatic.
RAG_ENABLED=true
RAG_MODEL=intfloat/multilingual-e5-small
RAG_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_ALLOW_DOWNLOAD=false
# RAG_CACHE_DIR=D:/your-project/.runtime/rag
# KNOWLEDGE_PATH=D:/your-project/data/knowledge

# Optional paths
# GOLDEN_DATASET_PATH=./data/golden_dataset_v3.json
# OUTPUT_DIR=./output
# LOG_FILE=./logs/t2p_system.log
# DATABASE_URL=sqlite:///./data/t2p.db
# MIRROR_JSON_PROGRESS=false

# Authentication
AUTH_SESSION_HOURS=24
PASSWORD_PBKDF2_ITERATIONS=600000

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://t2p:t2p_dev_password@127.0.0.1:5432/t2p

# OpenTelemetry (disabled by default for zero-overhead local development)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=t2p-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_CONSOLE_EXPORTER=false

# Frontend: place this in t2p-web/.env.local when overriding the backend URL
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
